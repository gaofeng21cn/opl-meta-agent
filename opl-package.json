{
  "schema_version": "opl.package.v2",
  "identity": {
    "id": "oma",
    "version": "0.4.16",
    "intent": "agent",
    "name": {
      "zh-CN": "OPL Meta Agent",
      "en-US": "OPL Meta Agent"
    },
    "summary": {
      "en-US": "OPL agent design, review, takeover, and evolution.",
      "zh-CN": "OPL 智能体的设计、评审、接管与演进。"
    },
    "description": {
      "en-US": "Provides OMA design and diagnosis semantics while OPL owns materialization, evaluation, versions, activation, and rollback.",
      "zh-CN": "提供 OMA 的设计和诊断语义，OPL 负责物化、评测、版本、激活和回滚。"
    },
    "publisher": "one-person-lab",
    "license": "Apache-2.0",
    "icon": "assets/branding/opl-meta-agent-logo.png",
    "repository": "https://github.com/gaofeng21cn/opl-meta-agent",
    "homepage": "https://github.com/gaofeng21cn/opl-meta-agent",
    "keywords": [
      "opl",
      "meta-agent",
      "codex",
      "agent-engineering"
    ],
    "routing_summary": {
      "en-US": "Create, take over, or improve an Agent through OPL Foundry.",
      "zh-CN": "通过 OPL Foundry 创建、接管或改进智能体。"
    },
    "default_prompts": [
      "Use OMA to create, take over, or improve an OPL-compatible Agent through engineer-agent."
    ],
    "home_shortcuts": [
      {
        "id": "engineer-agent",
        "label": {
          "en-US": "Engineer Agent",
          "zh-CN": "构建与迭代智能体"
        },
        "default_visible": true,
        "target": {
          "kind": "agent",
          "ref": "oma"
        }
      }
    ]
  },
  "dependencies": {
    "opl_base": "^2.0.0"
  },
  "provides": {
    "agent": {
      "stages_ref": "agent/stages/manifest.json"
    },
    "skills": [
      {
        "id": "opl-meta-agent",
        "path": "./agent/primary_skill",
        "exposure": "default"
      }
    ]
  },
  "distribution": {
    "oci": "ghcr.io/gaofeng21cn/one-person-lab-packages/oma",
    "visibility": "public"
  },
  "host_hints": {
    "codex": {
      "sync_enabled": true,
      "plugin_name": "opl-meta-agent",
      "category": "Productivity",
      "brand_color": "#4F5D95",
      "capabilities": [
        "Interactive",
        "Write"
      ]
    }
  }
}
